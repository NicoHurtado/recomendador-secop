# Desarrollo: contra la API real (CORS ya permite http://localhost:5173).
# Para trabajar sin internet, deja VITE_API_URL vacío: se usan los datos de src/api/fixtures.
# Plan B (docker-compose de secop-mlops): VITE_API_URL=http://localhost:8000
VITE_API_URL=https://i5rev77icbkeissqixiw6h5soi0npkxh.lambda-url.us-east-1.on.aws
# Estadísticas del dashboard: auto | api | local
#   auto  = usa la API si /estadisticas ya publica el indicador; si no, el snapshot local
#   api   = solo la API
#   local = solo el snapshot de public/data (oro si existe, si no el simulado)
VITE_ESTADISTICAS=auto
